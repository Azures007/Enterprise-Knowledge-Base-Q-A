# =============================================================================
# 阿里云百炼 API 配置
# =============================================================================
# API密钥（必填）
BAILIAN_API_KEY=sk-your-bailian-api-key-here

# API基础地址（默认使用阿里云百炼兼容OpenAI模式的地址）
BAILIAN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# =============================================================================
# 模型配置
# =============================================================================
# 文本生成模型（默认 qwen-plus，可选 qwen-max、qwen-turbo 等）
LLM_MODEL_NAME=qwen-plus

# 文本嵌入模型（默认 text-embedding-v3）
EMBEDDING_MODEL_NAME=text-embedding-v3

# =============================================================================
# 向量数据库配置
# =============================================================================
# 向量存储后端类型: pg（PostgreSQL+pgvector，推荐）| chroma（ChromaDB 嵌入式）
VECTOR_STORE_TYPE=pg

# ChromaDB 持久化路径（仅 VECTOR_STORE_TYPE=chroma 时生效）
VECTOR_DB_PATH=./data/chroma_db

# =============================================================================
# 文档处理配置
# =============================================================================
# 文本分块大小（字符数）
CHUNK_SIZE=500

# 文本分块重叠大小（字符数）
CHUNK_OVERLAP=100

# =============================================================================
# 检索配置
# =============================================================================
# 检索后最终返回的最相关文档块数量
RETRIEVAL_TOP_K=5
# 向量检索的候选块数量（重排前的粗召回，重排后取前 RETRIEVAL_TOP_K）
RETRIEVAL_CANDIDATE_K=20
# 是否启用重排（优先 bge-reranker 交叉编码器，不可用时自动降级为关键词轻量重排）
RERANK_ENABLED=true
# 交叉编码器模型名（可选，安装 sentence-transformers 后生效）
# RERANKER_MODEL=BAAI/bge-reranker-base

# =============================================================================
# 数据库配置（PostgreSQL + pgvector，仅 VECTOR_STORE_TYPE=pg 时生效）
# =============================================================================
# PostgreSQL 连接字符串
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/knowledge_base

# =============================================================================
# 对象存储配置（原始文件存储在云端时使用）
# =============================================================================
# 文件存储后端: local | oss | s3
STORAGE_BACKEND=local
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=my-knowledge-base
OSS_ACCESS_KEY=your_access_key
OSS_SECRET_KEY=your_secret_key

# =============================================================================
# 认证配置（生产环境建议启用）
# =============================================================================
# 是否启用 API 认证（true 后所有 /api 接口需携带 token 或 API Key）
AUTH_ENABLED=true
# JWT 签名密钥（生产环境务必改为随机长字符串）
JWT_SECRET_KEY=change-me-in-production
# 管理员账号（首次登录时自动创建）
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=admin123
# 静态 API Key 列表（逗号分隔），非空时可用 X-API-Key 头认证
API_KEYS=

# =============================================================================
# 缓存配置
# =============================================================================
# 内存缓存最大条目数（LRU 淘汰）
CACHE_MAX_ENTRIES=10000
# 问答缓存 TTL（秒）
CACHE_QA_TTL=3600

# =============================================================================
# 查询审计配置
# =============================================================================
# 是否启用查询审计（记录每次问答的用户/问题/来源/Token 用量等到 query_audit_log，
# 供管理员通过 /api/audit/queries 与 /api/audit/summary 查询）
AUDIT_ENABLED=true

# =============================================================================
# 工具调用配置（Function Calling / Agentic 检索）
# =============================================================================
# 是否启用工具调用模式：LLM 自主决定调用 list_collections / search_knowledge_base
# 等工具检索知识库，而不是固定走自动检索。默认关闭，渐进启用。
TOOL_CALLING_ENABLED=false
# 工具循环最大轮数（防死循环）
TOOL_CALLING_MAX_ROUNDS=4
# 工具结果截断字符数（防上下文爆炸）
TOOL_CALLING_RESULT_LIMIT=2000
